#!/usr/bin/env bash
# ac: manage agentControl's Claude Code sessions from any terminal.
# Needs a Python with PyGObject (GTK 4, libadwaita, VTE): the system one by default.
# Live desktop streams are optional: hypr-computer is used if it's checked out next to this repo
# (../hypr-computer) or at $HYPR_COMPUTER_SRC.
here="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
hc="${HYPR_COMPUTER_SRC:-$here/../hypr-computer/src}"
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
[ -d "$hc" ] && PYTHONPATH="$PYTHONPATH:$hc"
exec "${AGENTCONTROL_PYTHON:-/usr/bin/python3}" -m agentcontrol.cli "$@"
